variant: openshift
version: 4.20.0
metadata:
  name: 99-master-openperouter
  labels:
    machineconfiguration.openshift.io/role: master
storage:
  files:

    - path: /usr/local/bin/can_start.sh
      mode: 0755
      overwrite: true
      contents:
        local: can_start.sh
    - path: /var/lib/openperouter/can_start.sh
      mode: 0755
      overwrite: true
      contents:
        local: can_start.sh

    - path: /var/lib/openperouter/configs/default_config.yaml
      mode: 0644
      overwrite: true
      contents:
        local: openpe_default_config.yaml

    - path: /var/lib/openperouter/configs/master-1.sno-lab.example.com.yaml
      mode: 0644
      overwrite: true
      contents:
        local: openpe_master-1.sno-lab.example.com.yaml
    
    - path: /var/lib/openperouter/configs/master-2.sno-lab.example.com.yaml
      mode: 0644
      overwrite: true
      contents:
        local: openpe_master-2.sno-lab.example.com.yaml

    - path: /etc/openperouter/openperouter.env
      mode: 0644
      overwrite: true
      contents:
        local: openperouter.env
    # --- FRR daemons file (enables isisd for ISIS + SRv6) ---
    - path: /etc/perouter/daemons
      mode: 0644
      overwrite: true
      contents:
        local: daemons
    # --- Shared installer patching script ---
    - path: /usr/local/bin/patch-installer-config.sh
      mode: 0755
      overwrite: true
      contents:
        local: patch-installer-config.sh
    - path: /etc/kubernetes/manifests/workload-pod.yaml
      mode: 0644
      overwrite: true
      contents:
        local: workload-pod.yaml
    # --- Quadlet files ---
    - path: /etc/containers/systemd/controllerpod.pod
      mode: 0644
      overwrite: true
      contents:
        local: controllerpod.pod
    - path: /etc/containers/systemd/controller.container
      mode: 0644
      overwrite: true
      contents:
        local: controller.container
    - path: /etc/containers/systemd/routerpod.pod
      mode: 0644
      overwrite: true
      contents:
        local: routerpod.pod
    - path: /etc/containers/systemd/frr.container
      mode: 0644
      overwrite: true
      contents:
        local: frr.container
    - path: /etc/containers/systemd/reloader.container
      mode: 0644
      overwrite: true
      contents:
        local: reloader.container
    - path: /etc/containers/systemd/grout.container
      mode: 0644
      overwrite: true
      contents:
        local: grout.container
    - path: /etc/sysctl.d/99-no-slaac.conf
      mode: 0644
      overwrite: true
      contents:
        inline: |
          net.ipv6.conf.default.accept_ra = 0
    - path: /usr/local/bin/openperouter-node-index.sh
      mode: 0755
      overwrite: true
      contents:
        local: openperouter-node-index.sh
systemd:
  units:
    # --- Quadlet services ---
    - name: routerpod.service
      enabled: true
    # --- Rawconfig systemd services ---
    - name: grout.slice
      enabled: true
      contents: |
        [Slice]
        AllowedCPUs=0-6
        [Install]
        WantedBy=default.target

    # Restart bot router and controller pods. This is needed in case of Grout failure to trigger a controller reconfiguration
    - name: perouter-restart-pods.service
      enabled: false
      contents: |
        [Unit]
        Description=Restart All the PERouter pods

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl restart controllerpod-pod.service routerpod-pod.service

    
    # --- Shared installer patching service ---
    - name: enable-virtual-interfaces.service
      enabled: true
      contents: |
        [Unit]
        Description=Patch Assisted Service installer config for openperouter
        Before=assisted-service-pod.service

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/patch-installer-config.sh
        Restart=on-failure
        RestartSec=2
        RemainAfterExit=yes

        [Install]
        WantedBy=assisted-service-pod.service
    - name: openperouter-node-index.service
      enabled: true
      contents: |
        [Unit]
        Description=Set OpenPERouter nodeIndex from bridge IP
        After=network-online.target
        Before=controllerpod.service routerpod.service
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/local/bin/openperouter-node-index.sh
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
    
    - name: load-vfio-pci.service
      enabled: true
      contents: |
        [Unit]
        Description=Load vfio-pci kernel module
        After=local-fs-pre.target
        Wants=local-fs-pre.target

        [Service]
        Type=oneshot
        ExecStart=modprobe vfio-pci
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

